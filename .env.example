# Example local configuration. Values are intentionally non-secret.
WORKSPACE_ROOT=.
READ_ONLY_MODE=true
MAX_FILE_SIZE_BYTES=1048576
MAX_COMMAND_SECONDS=30
MAX_OUTPUT_BYTES=1048576
ALLOWED_COMMANDS=python,pytest,ruff,git
TEST_COMMANDS=[{"name":"unit","command":["pytest","tests/unit"]}]
ARTIFACT_DIRECTORY=artifacts
SECRET_PATTERNS=["(?i)(api[_-]?key|token|secret|password)\\s*[:=]\\s*[^\\s]+"]
LOG_LEVEL=INFO
